# Reference only; copy to .env for LOCAL use. Never commit the real file.
# RepoRun: enter the application/database values below in stack-level settings.
APP_ENV=demo
APP_URL=http://localhost:8080
APP_BASE_PATH=
APP_KEY=
APP_INDEXABLE=false
DEMO_MODE=true
SEED_DEMO=true
# Required on first hosted demo installation; private random 16-72 byte password.
# Optional locally. Existing administrator passwords are never reset on redeploy.
DEMO_ADMIN_PASSWORD=
SESSION_SECURE=false
TRUST_PROXY=false
DB_NAME=fitness_factory
DB_USER=fitness_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Local override only: these four values are read by compose.local.yml.
# RepoRun uses literal limits in docker-compose.yml: 0.25 CPU / 512m per service.
# Do not enter these local resource variables in RepoRun.
WEB_CPUS=0.50
WEB_MEMORY=512m
DB_CPUS=0.50
DB_MEMORY=512m
LOCAL_PORT=8080
